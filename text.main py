import sqlite3
from datetime import datetime
from typing import Optional

class AlWahaResortSystem:
    def __init__(self, db_name: str = "alwaha_resort.db"):
        self.db_name = db_name
        self.conn = sqlite3.connect(self.db_name)
        self.conn.row_factory = sqlite3.Row
        self._init_db()
        self._seed_units_data()

    def _init_db(self):
        """إنشاء كافة جداول قاعدة البيانات المرتبطة بالنظام"""
        cursor = self.conn.cursor()
        cursor.executescript("""
        CREATE TABLE IF NOT EXISTS units (
            unit_id TEXT PRIMARY KEY,
            unit_name TEXT NOT NULL,
            category TEXT NOT NULL,
            rental_basis TEXT NOT NULL,
            capacity INTEGER NOT NULL,
            price REAL NOT NULL,
            status TEXT DEFAULT 'جاهز',
            specs TEXT
        );

        CREATE TABLE IF NOT EXISTS guests (
            guest_id INTEGER PRIMARY KEY AUTOINCREMENT,
            full_name TEXT NOT NULL,
            phone TEXT UNIQUE NOT NULL
        );

        CREATE TABLE IF NOT EXISTS bookings (
            booking_id TEXT PRIMARY KEY,
            guest_id INTEGER,
            unit_id TEXT,
            booking_type TEXT,
            start_time TEXT,
            end_time TEXT,
            duration REAL,
            unit_price REAL,
            extra_services REAL DEFAULT 0,
            discount REAL DEFAULT 0,
            total_amount REAL,
            paid_deposit REAL,
            remaining_balance REAL,
            payment_method TEXT,
            booking_status TEXT DEFAULT 'مؤكد',
            FOREIGN KEY (guest_id) REFERENCES guests(guest_id),
            FOREIGN KEY (unit_id) REFERENCES units(unit_id)
        );
        """)
        self.conn.commit()

