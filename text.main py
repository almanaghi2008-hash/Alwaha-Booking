    def get_or_create_guest(self, full_name: str, phone: str) -> int:
        cursor = self.conn.cursor()
        cursor.execute("SELECT guest_id FROM guests WHERE phone = ?", (phone,))
        res = cursor.fetchone()
        if res:
            return res["guest_id"]
        cursor.execute("INSERT INTO guests (full_name, phone) VALUES (?, ?)", (full_name, phone))
        self.conn.commit()
        return cursor.lastrowid

    def check_availability(self, unit_id: str, start_dt: datetime, end_dt: datetime) -> bool:
        cursor = self.conn.cursor()
        query = """
        SELECT start_time, end_time FROM bookings 
        WHERE unit_id = ? AND booking_status IN ('مؤكد', 'مسكن')
        """
        cursor.execute(query, (unit_id,))
        rows = cursor.fetchall()

        for row in rows:
            b_start = datetime.strptime(row["start_time"], "%Y-%m-%d %H:%M")
            b_end = datetime.strptime(row["end_time"], "%Y-%m-%d %H:%M")
            if max(start_dt, b_start) < min(end_dt, b_end):
                return False
        return True

    def create_booking(self, booking_id: str, guest_name: str, guest_phone: str, unit_id: str, 
                       start_time_str: str, end_time_str: str, deposit: float, 
                       extra_services: float = 0.0, discount: float = 0.0, payment_method: str = "نقداً"):
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM units WHERE unit_id = ?", (unit_id,))
        unit = cursor.fetchone()
        if not unit:
            raise ValueError(f"الوحدة برمز {unit_id} غير مسجلة.")

        dt_format = "%Y-%m-%d %H:%M"
        start_dt = datetime.strptime(start_time_str, dt_format)
        end_dt = datetime.strptime(end_time_str, dt_format)

        if not self.check_availability(unit_id, start_dt, end_dt):
            raise ValueError(f"تعذر الحجز: الوحدة {unit['unit_name']} محجوزة بالفعل في هذا التوقيت.")

        delta = end_dt - start_dt
        if unit["rental_basis"] == "daily":
            duration = max(1, delta.days if delta.days > 0 else 1)
        else:
            duration = max(1.0, round(delta.total_seconds() / 3600.0, 2))

        base_cost = duration * unit["price"]
        total_amount = base_cost + extra_services - discount
        remaining = total_amount - deposit
        guest_id = self.get_or_create_guest(guest_name, guest_phone)

        cursor.execute("""
        INSERT INTO bookings (
            booking_id, guest_id, unit_id, booking_type, start_time, end_time, 
            duration, unit_price, extra_services, discount, total_amount, paid_deposit, 
            remaining_balance, payment_method, booking_status
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'مؤكد')
        """, (
            booking_id, guest_id, unit_id, unit["rental_basis"], start_time_str, end_time_str,
            duration, unit["price"], extra_services, discount, total_amount, deposit,
            remaining, payment_method
        ))
        self.conn.commit()
        print(f"✓ تم تأكيد الحجز [{booking_id}] بنجاح للضيف: {guest_name} | المتبقي: {remaining:,.0f} ريال")

    def display_units(self):
        print("\n" + "="*85)
        print("دليل الوحدات والمرافق المتاحة - منتجع الواحة")
        print("="*85)
        cursor = self.conn.cursor()
        cursor.execute("SELECT unit_id, unit_name, rental_basis, price, capacity, status FROM units")
        for u in cursor.fetchall():
            rental_type = "يومي" if u["rental_basis"] == "daily" else "بالساعة"
            print(f"{u['unit_id']:<10} | {u['unit_name']:<25} | {rental_type:<8} | السعر: {u['price']:>7,.0f} ريال | السعة: {u['capacity']} أفراد")
        print("="*85)

    def display_dashboard(self):
        cursor = self.conn.cursor()
        cursor.execute("""
        SELECT 
            COUNT(*) as total_bookings,
            IFNULL(SUM(total_amount), 0) as total_rev,
            IFNULL(SUM(paid_deposit), 0) as collected,
            IFNULL(SUM(remaining_balance), 0) as pending
        FROM bookings
        """)
        stats = cursor.fetchone()

        print("\n" + "="*60)
        print("لوحة المؤشرات والتقرير المالي - منتجع الواحة")
        print("="*60)
        print(f"إجمالي الحجوزات المسجلة: {stats['total_bookings']} حجز")
        print(f"إجمالي الإيرادات التعاقدية: {stats['total_rev']:,.0f} ريال")
        print(f"المبالغ المحصلة (العربونات): {stats['collected']:,.0f} ريال")
        print(f"المتبقي للتحصيل عند الوصول: {stats['pending']:,.0f} ريال")
        print("="*60)

